<?xml version="1.0" encoding="utf-8"?><model version="NetLogo 7.0.0-beta0" snapToGrid="false" nlw-version="2.15.1 (be116725)">
  <code><![CDATA[breed [sbs sb]
breed [wvs wv]

globals [
  sb-survival
  wv-survival
  sb-reproduction
  wv-reproduction
]



;; =========================
;; SETUP
;; =========================

to setup
  clear-all

  ;; selectively bred organisms
  create-sbs Population [
    set color pink
    set shape "circle"
    set size 0.5
    setxy random-xcor random-ycor
  ]

  ;; wild variants
  create-wvs Population [
    set color sky
    set shape "circle"
    set size 0.5
    setxy random-xcor random-ycor
  ]

  reset-ticks
end



;; =========================
;; MAIN LOOP
;; =========================

to go

  update-rates

  ask sbs [
    sb-behavior
  ]

  ask wvs [
    wv-behavior
  ]

  ;; stop if populations too large
  if count sbs >= 100000 or count wvs >= 100000 [
    stop
  ]
 ;; stop if one population extinct
if count sbs = 0 [

  set sb-survival 0
  set sb-reproduction 0

  stop
]

if count wvs = 0 [

  set wv-survival 0
  set wv-reproduction 0

  stop
]
  tick
end



;; =========================
;; UPDATE RATES
;; =========================

to update-rates

  ;; =========================
  ;; DEFAULT CONDITIONS
  ;; =========================

  ;; SB better in normal environment
  set sb-survival 0.99
  set sb-reproduction 0.12

  ;; WV slower normally
  set wv-survival 0.98
  set wv-reproduction 0.08



  ;; =========================
  ;; TEMPERATURE EFFECT
  ;; =========================

  ;; moderate hot
  if Temperature > 35 and Temperature <= 40 [

    ;; SB decreases faster
    set sb-survival sb-survival - 0.15
    set sb-reproduction sb-reproduction - 0.08

    ;; WV adapts better
    set wv-survival wv-survival - 0.03
    set wv-reproduction wv-reproduction - 0.02
  ]


  ;; moderate cold
  if Temperature <= 15 and Temperature >= -5 [

    ;; SB decreases faster
    set sb-survival sb-survival - 0.18
    set sb-reproduction sb-reproduction - 0.09

    ;; WV adapts better
    set wv-survival wv-survival - 0.04
    set wv-reproduction wv-reproduction - 0.02
  ]


  ;; extreme hot
  if Temperature > 40 [

    ;; SB extinct
    set sb-survival 0
    set sb-reproduction 0

    ;; WV barely survives
    set wv-survival 0.94
    set wv-reproduction 0.005
  ]


  ;; extreme cold
  if Temperature < -5 [

    ;; SB extinct
    set sb-survival 0
    set sb-reproduction 0

    ;; WV barely survives
    set wv-survival 0.94
    set wv-reproduction 0.005
  ]



  ;; =========================
  ;; FOOD EFFECT
  ;; =========================

  ;; low food
  ;; 50 - 11
  if Food <= 50 and Food > 10 [

    ;; SB decreases faster
    set sb-survival sb-survival - 0.12
    set sb-reproduction sb-reproduction - 0.06

    ;; WV decreases slower
    set wv-survival wv-survival - 0.03
    set wv-reproduction wv-reproduction - 0.01
  ]


  ;; very low food
  ;; 10 - 6
  if Food <= 10 and Food > 5 [

    ;; SB nearly extinct
    set sb-survival 0.1
    set sb-reproduction 0

    ;; WV survives around 30
    set wv-survival 0.96
    set wv-reproduction 0.01
  ]


  ;; critical food
  ;; 5 or below
  if Food <= 5 [

    ;; SB extinct
    set sb-survival 0
    set sb-reproduction 0

    ;; WV barely survives
    set wv-survival 0.94
    set wv-reproduction 0.003
  ]



  ;; =========================
  ;; PREVENT NEGATIVE VALUES
  ;; =========================

  if sb-survival < 0 [
    set sb-survival 0
  ]

  if sb-reproduction < 0 [
    set sb-reproduction 0
  ]

  if wv-survival < 0 [
    set wv-survival 0
  ]

  if wv-reproduction < 0 [
    set wv-reproduction 0
  ]


  ;; extinct population = no rates

  if count sbs = 0 [
    set sb-survival 0
    set sb-reproduction 0
  ]

  if count wvs = 0 [
    set wv-survival 0
    set wv-reproduction 0
  ]

end



;; =========================
;; SB BEHAVIOR
;; =========================

to sb-behavior

  ;; survival
  if random-float 1 > sb-survival [
    die
    stop
  ]

  ;; reproduction
  if random-float 1 < sb-reproduction [
    hatch 1 [
      set color pink
      set shape "circle"
      rt random 360
      fd 1
    ]
  ]

end



;; =========================
;; WV BEHAVIOR
;; =========================

to wv-behavior

  ;; EXTREME TEMPERATURE
  ;; keep around 4 population
  if Temperature > 40 or Temperature < -5 [

    if count wvs <= 27 [
      stop
    ]
  ]


  ;; VERY LOW FOOD
  ;; keep around 30 population
  if Food <= 10 and Food > 5 [

    ;; reduce if above 30
    if count wvs > 27 [
      if random-float 1 < 0.2 [
        die
        stop
      ]
    ]

    ;; reproduce if below 30
    if count wvs < 27 [
      if random-float 1 < 0.2 [
        hatch 1 [
          set color sky
          rt random 360
          fd 1
        ]
      ]
    ]
  ]


  ;; CRITICAL FOOD
  ;; keep around 4 population
  if Food <= 5 [

    if count wvs <= 4 [
      stop
    ]
  ]


  ;; normal survival
  if random-float 1 > wv-survival [
    die
    stop
  ]


  ;; normal reproduction
  if random-float 1 < wv-reproduction [
    hatch 1 [
      set color sky
      set shape "circle"
      rt random 360
      fd 1
    ]
  ]

end



;; =========================
;; DEFAULT SETTINGS
;; =========================

to default-settings

  set Temperature 25
  set Population 50
  set Food 100

end]]></code>
